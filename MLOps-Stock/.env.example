# Local artifact / MLflow
LOCAL_MODELS_DIR=./models
MODELS_CACHE_DIR=./artifacts/model-cache
MLFLOW_TRACKING_URI=sqlite:////absolute/path/to/MLOps-Stock/mlflow.db

# Control plane
CONTROL_DB_PATH=./artifacts/control_plane.sqlite3
REGISTRY_PATH=./artifacts/registry/registry.json
CONTROL_ALLOWED_ORIGINS=http://127.0.0.1:8081
DEFAULT_ROLE=viewer

# Monitoring
MONITOR_SYMBOLS=VNM,FPT,VCB,HPG
REFERENCE_DAYS=120
CURRENT_DAYS=30
CHECK_INTERVAL_SECONDS=3600
DRIFT_MIN_SAMPLES=20
RETRAIN_EPOCHS=5
TFT_WINDOW_SIZE=60

# Service graph
DATA_SERVICE_URL=http://127.0.0.1:8001/fetch/{}
TFT_SERVICE_URL=http://127.0.0.1:8002/predict/tft
LGBM_SERVICE_URL=http://127.0.0.1:8003/predict/lgbm
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
